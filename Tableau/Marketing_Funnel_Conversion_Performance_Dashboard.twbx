      <column caption='Approved Conversion' datatype='integer' name='[Approved_Conversion]' role='measure' type='quantitative' />
      <column caption='Overall Conversion Rate' datatype='real' name='[Calculation_91760895640109056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Approved_Conversion])&#10;/&#10;SUM([Impressions])' />
      </column>
      <column caption='Customer Conversion Rate' datatype='real' name='[Calculation_91760895643246593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Approved_Conversion])&#10;/&#10;SUM([Clicks])' />
      </column>
      <column caption='Cost Per Customer' datatype='real' name='[Calculation_91760895644655618]' role='measure' type='quantitative'>
